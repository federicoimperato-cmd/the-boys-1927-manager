rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null && request.auth.token.email_verified == true; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function member() { return signed() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().role in ['admin','captain','staff','player']; }
    function activeOwn() { return member() && profile().playerId != '' && exists(/databases/$(database)/documents/players/$(profile().playerId)) && get(/databases/$(database)/documents/players/$(profile().playerId)).data.get('active',true) == true; }
    function admin() { return member() && profile().role == 'admin'; }
    function staff() { return member() && profile().role in ['admin','captain','staff']; }
    match /users/{id} {
      allow get: if signed() && (request.auth.uid == id || admin());
      allow list: if admin();
      allow create: if signed() && request.auth.uid == id && request.resource.data.keys().hasOnly(['email','name','role','playerId','createdAt']) && request.resource.data.email == request.auth.token.email && request.resource.data.role == 'pending' && request.resource.data.playerId == '';
      allow update: if admin() && request.resource.data.role in ['admin','captain','staff','player','pending'] && request.resource.data.email == resource.data.email && (request.auth.uid != id || request.resource.data.role == 'admin');
      allow delete: if false;
    }
    match /players/{id} { allow read: if staff() || (member() && migrated()); allow create, update: if staff() && (!migrated() || safePublic('playerKeys')); allow delete: if false; }
    match /fields/{id} { allow read: if staff() || (member() && migrated()); allow create, update: if admin() && (!migrated() || (id in get(/databases/$(database)/documents/privacyConfig/main).data.playerKeys || id in get(/databases/$(database)/documents/privacyConfig/main).data.recordKeys)); allow delete: if admin() && !migrated(); }
    match /privateFields/{id} { allow read: if staff(); allow create, update: if admin(); allow delete: if false; }
    match /matches/{id} { allow read: if member(); allow create, update: if staff(); allow delete: if false; }
    match /records/{id} { allow read: if staff() || (member() && migrated()); allow create, update: if staff() && (!migrated() || safePublic('recordKeys')); allow delete: if staff(); }
    match /formations/{id} { allow read: if member(); allow create: if staff() && request.resource.data.status == 'draft'; allow update: if staff() && (request.resource.data.status == 'draft' || (profile().role in ['admin','captain'] && request.resource.data.status == 'approved')); allow delete: if false; }
    match /staffNotes/{id} { allow read: if staff(); allow create, update: if staff(); allow delete: if false; }
    match /availability/{id} {
      allow read: if member();
      function ownAvailability() { return activeOwn() && request.resource.data.playerId == profile().playerId && id == request.resource.data.matchId + '_' + request.resource.data.playerId && request.resource.data.keys().hasOnly(['matchId','playerId','status','note','updatedAt','eventSchedule']) && request.resource.data.status in ['yes','maybe','no','pending'] && exists(/databases/$(database)/documents/matches/$(request.resource.data.matchId)) && get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.status == 'planned'; }
      allow create: if staff() || ownAvailability();
      allow update: if staff() || (ownAvailability() && resource.data.playerId == profile().playerId && resource.data.matchId == request.resource.data.matchId);
      allow delete: if staff();
    }
    match /dailyAvailability/{id} {
      allow read: if member();
      function validOwnDay() { return activeOwn() && request.resource.data.playerId == profile().playerId && id == request.resource.data.date + '_' + profile().playerId && request.resource.data.keys().hasOnly(['date','playerId','status','from','to','updatedAt']) && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.status in ['yes','maybe','no'] && request.resource.data.from is string && request.resource.data.to is string; }
      allow create: if staff() || validOwnDay();
      allow update: if staff() || (validOwnDay() && resource.data.playerId == profile().playerId && resource.data.date == request.resource.data.date);
      allow delete: if staff();
    }
    match /availabilityHistory/{id} {
      allow read: if staff();
      allow create: if member() && (staff() || (profile().playerId != '' && request.resource.data.playerId == profile().playerId))
        && request.resource.data.keys().hasOnly(['date','playerId','previous','current','updatedAt'])
        && request.resource.data.date is string && request.resource.data.playerId is string
        && request.resource.data.current is map
        && getAfter(/databases/$(database)/documents/dailyAvailability/$(request.resource.data.date + '_' + request.resource.data.playerId)).data.status == request.resource.data.current.status
        && getAfter(/databases/$(database)/documents/dailyAvailability/$(request.resource.data.date + '_' + request.resource.data.playerId)).data.updatedAt == request.resource.data.updatedAt;
      allow update, delete: if false;
    }
    match /profiles/{id} {
      allow read: if member();
      allow create, update: if staff() || (activeOwn() && profile().playerId == id && id != '' && request.resource.data.keys().hasOnly(['height','weight','gamertag','platform','archetype','foot','styles','plus','preferred','builds','photo','activeBuild']) && request.resource.data.get('photo','') is string && request.resource.data.get('photo','').size() <= 250000 && (request.resource.data.get('photo','') == '' || request.resource.data.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')));
      allow delete: if false;
    }
    match /proFeedback/{id} {
      allow read: if staff();
      allow create: if activeOwn() && request.resource.data.playerId == profile().playerId && request.resource.data.keys().hasOnly(['playerId','body','kind','createdAt']) && request.resource.data.body is string && request.resource.data.body.size() <= 2000 && request.resource.data.kind in ['feedback','highlight'];
      allow update, delete: if false;
    }
    match /objectives/{id} { allow read: if member(); allow create, update: if staff(); allow delete: if false; }
    function migrated() { return exists(/databases/$(database)/documents/privacyConfig/main) && get(/databases/$(database)/documents/privacyConfig/main).data.ready == true; }
    function safePublic(key) { return request.resource.data.get('notes','') == '' && request.resource.data.get('values',{}).keys().hasOnly(get(/databases/$(database)/documents/privacyConfig/main).data[key]); }
    function played(mid,pid) { return exists(/databases/$(database)/documents/records/$(mid + '_' + pid)) && get(/databases/$(database)/documents/records/$(mid + '_' + pid)).data.get('appeared',true) == true && get(/databases/$(database)/documents/matches/$(mid)).data.status == 'played'; }
    match /privacyConfig/{id} { allow read: if member(); allow create, update: if admin() && id == 'main'; }
    match /privatePlayers/{id} { allow read, write: if staff(); }
    match /privateRecords/{id} { allow read, write: if staff(); }
    match /mvpVotes/{id} { allow list: if staff(); allow get: if staff() || (activeOwn() && (resource == null || resource.data.playerId == profile().playerId)); allow create: if activeOwn() && migrated() && request.resource.data.keys().hasOnly(['matchId','playerId','target']) && request.resource.data.playerId == profile().playerId && id == request.resource.data.matchId + '_' + profile().playerId && request.resource.data.target != profile().playerId && played(request.resource.data.matchId,profile().playerId) && played(request.resource.data.matchId,request.resource.data.target) && get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.mvpOpen == true; allow update, delete: if false; }
    match /selfVotes/{id} { allow list: if staff(); allow get: if staff() || (activeOwn() && (resource == null || resource.data.playerId == profile().playerId)); allow create, update: if activeOwn() && request.resource.data.keys().hasOnly(['matchId','playerId','score','note']) && request.resource.data.playerId == profile().playerId && id == request.resource.data.matchId + '_' + profile().playerId && played(request.resource.data.matchId,profile().playerId) && request.resource.data.score is int && request.resource.data.score >= 1 && request.resource.data.score <= 10 && request.resource.data.note is string && request.resource.data.note.size() <= 1000; }
    match /highlights/{id} { allow read: if member(); allow create, update, delete: if staff(); }
    match /earnedAwards/{id} { allow read: if member(); allow create: if staff() && request.resource.data.keys().hasOnly(['playerId','name','earnedOn']); allow update, delete: if false; }
    match /awardDefinitions/{id} { allow read: if member(); allow create, update: if staff(); allow delete: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
